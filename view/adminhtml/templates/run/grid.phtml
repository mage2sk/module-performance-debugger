        <?php
        $pagerWindow = 5;
        $start = max(1, $page - intdiv($pagerWindow, 2));
        $end   = min($totalPages, $start + $pagerWindow - 1);
        $start = max(1, $end - $pagerWindow + 1);
        ?>
        <div class="panth-perf-pager">
            <div class="info"><?= $block->escapeHtml(__('Showing %1-%2 of %3', $first, $last, number_format($total))) ?></div>
            <div class="nums">
                <?php if ($page > 1): ?>
                    <a href="<?= $block->escapeUrl($block->gridUrl(['p' => 1])) ?>" title="<?= $block->escapeHtmlAttr(__('First')) ?>">&laquo;</a>
                    <a href="<?= $block->escapeUrl($block->gridUrl(['p' => $page - 1])) ?>" title="<?= $block->escapeHtmlAttr(__('Previous')) ?>">&lsaquo;</a>
                <?php else: ?>
                    <span class="pg disabled">&laquo;</span><span class="pg disabled">&lsaquo;</span>
                <?php endif; ?>

                <?php for ($i = $start; $i <= $end; $i++): ?>
                    <?php if ($i === $page): ?>
                        <span class="pg current"><?= $i ?></span>
                    <?php else: ?>
                        <a href="<?= $block->escapeUrl($block->gridUrl(['p' => $i])) ?>"><?= $i ?></a>
                    <?php endif; ?>
                <?php endfor; ?>

                <?php if ($page < $totalPages): ?>
                    <a href="<?= $block->escapeUrl($block->gridUrl(['p' => $page + 1])) ?>" title="<?= $block->escapeHtmlAttr(__('Next')) ?>">&rsaquo;</a>
                    <a href="<?= $block->escapeUrl($block->gridUrl(['p' => $totalPages])) ?>" title="<?= $block->escapeHtmlAttr(__('Last')) ?>">&raquo;</a>
                <?php else: ?>
                    <span class="pg disabled">&rsaquo;</span><span class="pg disabled">&raquo;</span>
                <?php endif; ?>
            </div>
            <div class="info"><?= $block->escapeHtml(__('Page %1 of %2', $page, $totalPages)) ?></div>
