$run = $block->getRun();
if (!$run) {
    return;
}
$summary = $run['summary_decoded'] ?? [];
$allFindings = $summary['findings'] ?? [];
$findings = array_values(array_filter($allFindings, fn($f) => empty($f['is_core'])));
